{
  "schema": 1,
  "note": "命令 → 层 的路由表。tc-which 读它；未命中的按『Alpine 内是否已有』决定。三层都不是运行档，engine 永远只有 Alpine 一份。",
  "layers": {
    "apk": {
      "desc": "Alpine 原生 musl 包（首选，体积最小、无需 overlay）",
      "prep": "apk add --no-cache"
    },
    "deb": {
      "desc": "从 .deb 里提取单文件二进制 + gcompat 兼容层（中等体积，无 apt）",
      "root": "$DSH_HOME/toolchain/deb",
      "guestMount": "/opt/deb",
      "prep": "apk add gcompat libstdc++ zlib"
    },
    "overlay": {
      "desc": "Ubuntu base rootfs + 真 apt（可抛弃，只在需要依赖树时挂载）",
      "root": "$DSH_HOME/toolchain/ubuntu",
      "prep": "install-overlay.sh"
    }
  },
  "routes": [
    { "cmd": "go",        "layer": "apk",     "pkg": "go",            "sizeMB": 260 },
    { "cmd": "gofmt",     "layer": "apk",     "pkg": "go" },
    { "cmd": "rustc",     "layer": "apk",     "pkg": "rust",          "sizeMB": 380 },
    { "cmd": "cargo",     "layer": "apk",     "pkg": "rust" },
    { "cmd": "rustup",    "layer": "overlay", "why": "rustup 官方脚本按 glibc 判平台；musl 直接用 apk rust 更省" },
    { "cmd": "java",      "layer": "apk",     "pkg": "openjdk17-jdk","sizeMB": 190 },
    { "cmd": "javac",     "layer": "apk",     "pkg": "openjdk17-jdk" },
    { "cmd": "mvn",       "layer": "apk",     "pkg": "maven",         "sizeMB": 40 },
    { "cmd": "gradle",    "layer": "overlay", "why": "发行包 wrapper + 版本敏感，overlay 里最省心" },
    { "cmd": "ffmpeg",    "layer": "apk",     "pkg": "ffmpeg",        "sizeMB": 45 },
    { "cmd": "gcc",       "layer": "apk",     "pkg": "build-base",    "sizeMB": 120 },
    { "cmd": "g++",       "layer": "apk",     "pkg": "build-base" },
    { "cmd": "make",      "layer": "apk",     "pkg": "build-base" },
    { "cmd": "cmake",     "layer": "apk",     "pkg": "cmake samurai", "sizeMB": 60 },
    { "cmd": "git",       "layer": "apk",     "pkg": "git",           "sizeMB": 30 },
    { "cmd": "adb",       "layer": "apk",     "pkg": "android-tools", "sizeMB": 12 },
    { "cmd": "pandoc",    "layer": "apk",     "pkg": "pandoc",        "sizeMB": 120 },
    { "cmd": "gh",        "layer": "deb",     "pkg": "gh",            "why": "官方 .deb 里是近乎静态的单文件" },
    { "cmd": "aapt2",     "layer": "overlay", "why": "Android build-tools 里是 glibc 二进制" },
    { "cmd": "d8",        "layer": "overlay" },
    { "cmd": "sdkmanager", "layer": "overlay", "why": "cmdline-tools 依赖 glibc + java" },
    { "cmd": "dotnet",    "layer": "overlay", "why": "官方有 linux-musl-arm64 包，但体积大；overlay 里 apt 更稳" },
    { "cmd": "playwright", "layer": "overlay", "why": "Chromium 只有 glibc 构建" },
    { "cmd": "chromium",  "layer": "overlay" },
    { "cmd": "onnxruntime", "layer": "overlay", "why": "20 样本实测：只有 glibc 产物，无 musl/无 android" },
    { "cmd": "node-gyp",  "layer": "apk",     "pkg": "python3 make g++", "why": "编 musl 原生模块" },
    { "cmd": "python3",   "layer": "apk",     "pkg": "python3",       "sizeMB": 23 },
    { "cmd": "pip",       "layer": "apk",     "pkg": "py3-pip",       "sizeMB": 6 },
    { "cmd": "uv",        "layer": "apk",     "pkg": "uv",            "sizeMB": 15 }
  ],
  "abiGuard": {
    "note": "产物进 Alpine 之前的硬闸门。glibc 产物一律不许落地到 engine/node_modules。",
    "allowedIntoAlpine": ["musl", "static", "no-native"],
    "blocked": ["glibc", "bionic"],
    "scanGlobs": ["**/*.node", "**/bin/*", "**/*.so"]
  },
  "volumeBudget": {
    "alpineRuntimeMB": 89,
    "overlayBaseMB": 30,
    "overlayWithJDKMB": 300,
    "debLayerMB": 8,
    "note": "overlay 与 deb 层可按需删除；Alpine 档 89 MB 永远可用"
  }
}
