<?xml version="1.0" encoding="utf-8"?>
<!--
  失败浮层上「安全模式」按钮的底：半透明描边 + 深色填充。

  ⚠️ 刻意**不用** bubble_send_bg 那种实心蓝：那个蓝是"主操作"的语言，
  而安全模式是**破坏性**的（会推开用户的插件配置）。视觉上要能点、但不抢眼，
  所以用描边而不是填充。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1A2534" />
    <stroke
        android:width="1dp"
        android:color="#3A4A63" />
    <corners android:radius="10dp" />
</shape>
