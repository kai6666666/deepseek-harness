<?xml version="1.0" encoding="utf-8"?>
<!--
  导出 / 导入共用同一个对话框布局（内容由代码填）。

  ## 为什么用代码动态填列表而不是写死七行

  **导出**要知道哪些项真的存在（新装用户可能一个会话都没有）；
  **导入**要知道包里到底有什么（用户可能只导出了 sessions）。
  两者都是运行时才知道的，写死就会显示一堆「0 B」的空项。

  ## 为什么是 Dialog 而不是 Activity

  它要能从**启动层**弹出，而启动层在 MainActivity 里、且引擎可能已经挂了。
  用 Dialog 不新增 Activity 生命周期，也不受 WebView 状态影响。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF1A1F2A"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFE8EDF5"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="导出数据" />

        <TextView
            android:id="@+id/bkHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#FF8FA3C0"
            android:textSize="12.5sp"
            tools:text="勾选要导出的内容。" />

        <!-- 导入时用来选文件；导出时隐藏 -->
        <TextView
            android:id="@+id/bkPick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/log_chip_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/backup_import_pick"
            android:textColor="#FFDCE6F5"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/bkFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF7EC8A0"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 勾选项容器：代码往里塞行 -->
        <LinearLayout
            android:id="@+id/bkList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/bkTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="#FF8FA3C0"
            android:textSize="12.5sp" />

        <!-- 进度条：处理中显示 -->
        <ProgressBar
            android:id="@+id/bkProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bkCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/log_chip_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp"
                android:paddingBottom="10dp"
                android:text="@string/backup_cancel"
                android:textColor="#FF8FA3C0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bkAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/overlay_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="22dp"
                android:paddingTop="10dp"
                android:paddingEnd="22dp"
                android:paddingBottom="10dp"
                android:text="@string/backup_do_export"
                android:textColor="#FFDCE6F5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
